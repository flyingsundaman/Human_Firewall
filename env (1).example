# .env.example — Human Firewall Lite
#
# Copy file ini jadi ".env" (di root project, sejajar sama docker-compose.yml),
# terus isi semua value di bawah dengan value asli punya lu.
# JANGAN commit file ".env" yang udah keisi ke git — cuma file .env.example
# ini yang boleh masuk repo.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# CORE SECURITY — WAJIB diisi, Flask app REFUSE START kalau kosong
# ---------------------------------------------------------------------------

# Password buat login admin dashboard (session-based auth)
ADMIN_PASSWORD=ganti_dengan_password_kuat_disini

# Secret key Flask (dipakai buat sign session cookie, DAN dipakai sebagai
# shared secret buat server-to-server auth via "Authorization: Bearer <SECRET_KEY>"
# — dipakai n8n buat manggil endpoint yang protected kayak POST /api/reports)
SECRET_KEY=ganti_dengan_random_string_panjang_disini

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Origin yang boleh akses API dari browser (comma-separated kalau lebih dari satu)
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# TELEGRAM BOT
# ---------------------------------------------------------------------------

# Username bot Telegram (tanpa @), dipakai buat generate deep link registrasi
BOT_USERNAME=nama_bot_telegram_lu

# Chat ID grup/channel Incident Response — tempat SOC alert dikirim n8n
# (BUKAN chat_id personal reporter — ini sempat jadi bug, pastikan ini
# grup IR beneran, bukan chat_id individu)
SOC_CHAT_ID=chat_id_grup_soc_disini

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------

# Base URL publik buat n8n webhook (dipakai kalau expose ke internet,
# misal via ngrok/domain asli — kalau full local testing bisa diisi
# http://localhost:5678 sementara)
WEBHOOK_URL=http://localhost:5678

# ---------------------------------------------------------------------------
# GOPHISH
# ---------------------------------------------------------------------------

# API key GoPhish (bisa dilihat di admin panel GoPhish setelah pertama kali start)
GOPHISH_API_KEY=api_key_gophish_disini

# URL API GoPhish (biasanya https://gophish:3333 kalau dipanggil dari
# container lain di network yang sama, BUKAN localhost)
GOPHISH_API_URL=https://gophish:3333

# ---------------------------------------------------------------------------
# THREAT INTELLIGENCE (Flow B — dipakai n8n buat triase laporan URL/file)
# ---------------------------------------------------------------------------

# VirusTotal API key (dapetin gratis di virustotal.com, ada rate limit
# di free tier — cek dulu kalau demo butuh banyak request sekaligus)
VT_API_KEY=api_key_virustotal_disini

# urlscan.io API key
URLSCAN_API_KEY=api_key_urlscan_disini
