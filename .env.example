# =====================================================
# HUMAN FIREWALL — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file ini menjadi .env dan sesuaikan nilainya.
# =====================================================

# -----------------------------------------------------
# 1. Flask Backend & Core API Configuration
# -----------------------------------------------------
SECRET_KEY=your_super_secret_flask_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Service API Key (Authentikasi internal: n8n <-> Flask <-> Next.js Proxy)
SERVICE_API_KEY=your_internal_service_api_key_here

# -----------------------------------------------------
# 2. Telegram Bot & SOC Alerting (Flow B)
# -----------------------------------------------------
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_example
BOT_USERNAME=HumanFirewallBot
SOC_CHAT_ID=-1001234567890

# -----------------------------------------------------
# 3. Threat Intelligence API Keys
# -----------------------------------------------------
VT_API_KEY=your_virustotal_api_key_here
URLSCAN_API_KEY=your_urlscan_api_key_here

# -----------------------------------------------------
# 4. n8n Orchestrator Layer
# -----------------------------------------------------
WEBHOOK_URL=https://your-domain.trycloudflare.com
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# -----------------------------------------------------
# 5. GoPhish Simulation Engine (Flow A)
# -----------------------------------------------------
GOPHISH_API_KEY=your_gophish_admin_api_key_here
GOPHISH_API_URL=https://gophish:3333

# -----------------------------------------------------
# 6. Next.js Dashboard (Frontend Presentation)
# -----------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_BOT_USERNAME=HumanFirewallBot