# =============================================================================
# HUMAN FIREWALL — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy file ini menjadi .env dan isi nilai API key / konfigurasi rahasia.
# =============================================================================

# --- 1. Flask Core & Auth ---
SECRET_KEY=your_super_secret_flask_key_here
ADMIN_PASSWORD=change_this_admin_password_in_production
SERVICE_API_KEY=your_internal_service_api_key_here
DEV_BYPASS_AUTH=false
FLASK_DEBUG=true

# --- 2. AI Router & Multi-LLM Failover Chain ---
# Failover Order: OpenRouter (Primary) -> Google Gemini Native -> Groq
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
GEMINI_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# --- 3. Infrastructure & CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# --- 4. GoPhish Simulation Engine (Flow A) ---
GOPHISH_API_KEY=your_gophish_admin_api_key_here
GOPHISH_API_URL=https://gophish:3333

# --- 5. Telegram Bot & SOC Alerting (Flow B) ---
BOT_USERNAME=HFL_Notif_Bot
SOC_CHAT_ID=-1003979650342
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# --- 6. n8n Orchestrator & Webhooks ---
WEBHOOK_URL=https://your-pinggy-tunnel-or-domain.run.pinggy-free.link

# --- 7. Threat Intelligence API Keys ---
VT_API_KEY=your_virustotal_api_key_here
URLSCAN_API_KEY=your_urlscan_api_key_here

# --- 8. Next.js Dashboard Frontend ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_BOT_USERNAME=HFL_Notif_Bot
