        "jsCode": "const crypto = require('crypto');\nconst binaryData = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst hash = crypto.createHash('sha256').update(binaryData).digest('hex');\nreturn { json: { hash: hash } };"
